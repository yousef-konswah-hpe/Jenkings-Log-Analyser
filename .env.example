# LLM Configuration (GitHub Copilot)
# Get your token from: https://github.com/settings/tokens
# Required scopes: none (uses your Copilot subscription)
COPILOT_API_KEY=your_github_token_here
# GitHub Copilot endpoint (or https://api.openai.com/v1 for OpenAI)
COPILOT_API_URL=https://api.githubcopilot.com
# Model to use — gpt-4o recommended for Copilot
LLM_MODEL_NAME=gpt-4o
LLM_TIMEOUT_SECONDS=600
LLM_MAX_RETRIES=3

# RAG Embeddings (OpenAI-compatible)
EMBEDDING_MODEL=text-embedding-3-small

# Leave USER/PASSWORD empty for local dev (no auth needed)
MONGO_USER=
MONGO_PASSWORD=
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=jenkins
MONGO_AUTH_DB=admin
SMTP_SERVER=smtp.office365.com
SMTP_PORT=587
SMTP_FROM_EMAIL=your-name@hpe.com
SMTP_USERNAME=your-name@hpe.com
SMTP_PASSWORD=your-password-or-app-password
SMTP_USE_TLS=true
SMTP_USE_SSL=false
