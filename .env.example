# -------------------------------
# LLM / AI model configuration
# -------------------------------
# Provider: openai (OpenAI-compatible APIs) or ollama (local Ollama)
LLM_PROVIDER=ollama
# For ollama default local endpoint:
LLM_API_URL=http://localhost:11434/api/chat
# Example ollama models: llama3.1:8b, mistral, qwen2.5:7b
LLM_MODEL_NAME=llama3.1:8b
# Optional for OpenAI-compatible providers. Not required for local Ollama.
LLM_AUTH_TOKEN=
LLM_TIMEOUT_SECONDS=600
LLM_MAX_RETRIES=3
# true for valid public/internal CA certs, false only for self-signed dev setups
LLM_VERIFY_TLS=true

# -------------------------------
# MongoDB configuration
# -------------------------------
MONGO_USER=sample
MONGO_PASSWORD=sample123
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=jenkins
MONGO_AUTH_DB=admin

# -------------------------------
# SMTP / Email configuration
# -------------------------------
# SMTP server hostname (e.g. smtp.gmail.com, smtp3.hpe.com, mxdns01.hpelabs.net)
SMTP_SERVER=mxdns01.hpelabs.net
# Port: 25 (plain), 587 (STARTTLS), 465 (SSL). Leave 0 to auto-try 25→587→465.
SMTP_PORT=0
# Credentials (leave blank if the SMTP relay does not require auth)
SMTP_USERNAME=
SMTP_PASSWORD=
# Set to true to upgrade the connection with STARTTLS (port 587)
SMTP_USE_TLS=false
# Set to true for implicit SSL (port 465)
SMTP_USE_SSL=false
